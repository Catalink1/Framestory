# Blochează accesul direct la fișierele de configurare și la include-uri.
<FilesMatch "^(config\.php|config\.sample\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Permite upload-uri de imagini mai mari (dacă hostingul rulează mod_php).
<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>
